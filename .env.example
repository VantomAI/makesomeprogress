# Google Calendar OAuth (optional — leave blank to hide calendar sync feature)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional AI provider keys. The browser app stores keys locally via Settings,
# so these are only reminders for whichever provider account you use.
GEMINI_API_KEY=your_gemini_api_key_here
ZAI_API_KEY=your_zai_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Plaid bank import via Supabase Edge Functions.
# Start with PLAID_ENV=sandbox. Generate BANK_TOKEN_ENCRYPTION_KEY as a long random value.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
BANK_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
